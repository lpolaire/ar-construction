# Copy to .env and fill in. Never commit real secrets.

# Postgres (local dev = Docker on 5433 ; production = Neon pooled connection string)
DATABASE_URL=postgresql://arc:arcdev@localhost:5433/arconstruction

# Payload auth/encryption secret — generate: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Email (Resend) — Phase 4
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@ar-construction.ca

# Media storage (Vercel Blob) — production
# BLOB_READ_WRITE_TOKEN=

# Anti-spam (Cloudflare Turnstile) — Phase 4
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
